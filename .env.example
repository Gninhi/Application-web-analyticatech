# ==============================================================================
# 🚀 Analyticatech — Variables d'Environnement (Vercel & Production Ready)
# ==============================================================================
# Copier ce fichier en `.env` pour le développement local.
# Sur Vercel, configurer ces variables dans : Project Settings > Environment Variables
# ==============================================================================

# 1. Base de données Supabase PostgreSQL (Transaction Pooler - Port 6543)
# Utilisée par Prisma au runtime (Vercel). Remplacer [PASSWORD] par le mot de passe
# de la base et [PROJECT-REF] par le ref du projet (ex: jorlivdlzdstkmahecmr).
# IMPORTANT Vercel : garder le port 6543 (pooler = IPv4). Le port 5432 direct
# résout en IPv6, non supporté par Vercel.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# SSL de la connexion Prisma (pooler Supabase). Le certificat du pooler est
# signé par la CA racine privée Supabase (`src/lib/db/supabase-ca-2021.crt`,
# publique, versionnée dans le repo) → vérification stricte `verify-full`
# (rejectUnauthorized: true + CA piégée). Mettre "false" uniquement pour une
# base locale (Postgres/Docker) sans TLS — jamais en production.
DATABASE_SSL="true"

# 2. Base de données Supabase Direct URL (Connexion Directe - Port 5432)
# Requis par Prisma pour exécuter `prisma migrate` et `prisma db push` sans passer par PgBouncer
# (utilisée uniquement par la CLI en local, pas par Vercel).
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 3. Supabase — URL de l'API (projet)
# Utilisée par le client supabase-js (coté navigateur) si besoin.
# PLACEHOLDER : remplacer par l'URL réelle du projet (ex: https://XXXX.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="<SUPABASE_PROJECT_URL_PUBLIQUE>"

# 4. Supabase — Clé API publique (Anon)
# Clé publique de navigation (publishable), sans danger de l'exposer au client.
# La retrouver dans : Supabase Dashboard > Project Settings > API
# PLACEHOLDER : remplacer par la clé anon/publishable réelle du projet.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<SUPABASE_ANON_KEY_PUBLIQUE>"

# 5. Sécurité RGPD & Hachage
# Sel cryptographique pour le hachage irréversible des IP (Audit & Rate Limiting).
# PROD : Générer une clé forte de 64 car. (ex: `openssl rand -hex 32`)
IP_SALT="replace-with-a-secure-random-64-character-hex-string-in-production"

# 6. Protection CSRF & Origines Autorisées
# Domaines autorisés séparés par des virgules pour la vérification d'origine HTTP
ALLOWED_ORIGINS="https://analyticatech.fr,https://www.analyticatech.fr,https://analyticatech-web.vercel.app"
NEXT_PUBLIC_SITE_URL="https://analyticatech.fr"

# Version de l'application exposée par /api/health (publique, injectée au build)
NEXT_PUBLIC_APP_VERSION="2.4.1"

# 7. Service Email Resend — Notification des soumissions du formulaire de contact
# RÉCEPTION : MAIL_TO est une boîte pro standard (M365, Google Workspace, OVH…),
# aucune config de réception requise.
# ENVOI : avant l'activation, vérifier le domaine dans Resend (resend.com/domains) :
#   - Ajouter les records DNS SPF + DKIM fournis par Resend chez ton registrar
#   - MAIL_FROM doit être une adresse sur le domaine vérifié (sinon spam / refus)
RESEND_API_KEY="re_xxxxxxxxxxxxx"
MAIL_FROM="Analyticatech <contact@analyticatech.fr>"
MAIL_TO="leads@analyticatech.fr"
