# ==============================================================================
# 🚀 Analyticatech — Variables d'Environnement (Vercel & Production Ready)
# ==============================================================================
# Copier ce fichier en `.env` pour le développement local.
# Sur Vercel, configurer ces variables dans : Project Settings > Environment Variables
# ==============================================================================

# 1. Base de données Supabase PostgreSQL (Transaction Pooler - Port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# 2. Base de données Supabase Direct URL (Connexion Directe - Port 5432)
# Requis par Prisma pour exécuter `prisma migrate` et `prisma db push` sans passer par PgBouncer
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 3. Sécurité RGPD & Hachage
# Sel cryptographique pour le hachage irréversible des IP (Audit & Rate Limiting).
# PROD : Générer une clé forte de 64 car. (ex: `openssl rand -hex 32`)
IP_SALT="replace-with-a-secure-random-64-character-hex-string-in-production"

# 4. Protection CSRF & Origines Autorisées
# Domaines autorisés séparés par des virgules pour la vérification d'origine HTTP
ALLOWED_ORIGINS="https://analyticatech.fr,https://www.analyticatech.fr,https://analyticatech-web.vercel.app"
NEXT_PUBLIC_SITE_URL="https://analyticatech.fr"

# 5. Service Email Resend (Optionnel - Mode Stub automatique si omis)
# Pour activer l'envoi de mails réels lors des soumissions du formulaire de contact :
# RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
# MAIL_FROM="Analyticatech Contact <contact@analyticatech.fr>"
# MAIL_TO="contact@analyticatech.fr"
