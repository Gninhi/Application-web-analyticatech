generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Métriques affichées sur la home (missions livrées, uptime, etc.)
/// `numericValue` permet les tris/graphs ; `sparkline` (JSONB) pour les graphes sparkline.
model Metric {
  id           String       @id @default(cuid())
  key          String       @unique
  label        String
  labelEn      String?
  value        String
  numericValue Float?
  suffix       String?
  trend        Float?
  sparkline    Json?
  source       MetricSource @default(static)
  order        Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// Logos / entreprises clientes (section "Ils nous font confiance")
model ClientLogo {
  id           String        @id @default(cuid())
  name         String        @unique
  sector       String?
  logoUrl      String?
  websiteUrl   String?
  order        Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  testimonials Testimonial[]
}

/// Service = offre d'Analyticatech (IA, Transformation, Automatisation, etc.)
/// Les contenus bilingues sont dans ServiceTranslation.
model Service {
  id           String               @id @default(cuid())
  index        String               @unique
  iconKey      String
  bgImagePath  String?
  meshOverlay  String?
  order        Int                  @default(0)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  metrics      ServiceMetric[]
  technologies ServiceTechnology[]
  translations ServiceTranslation[]
}

model ServiceTranslation {
  id          String  @id @default(cuid())
  serviceId   String
  locale      Locale
  title       String
  tagline     String
  description String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale])
}

model ServiceMetric {
  id        String  @id @default(cuid())
  serviceId String
  label     String
  value     String
  order     Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

/// Technologies/frameworks utilisés pour chaque service (LangChain, n8n, etc.)
model ServiceTechnology {
  id        String  @id @default(cuid())
  serviceId String
  name      String
  order     Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
  @@index([serviceId])
}

/// Solution = use-case sectoriel livré chez un client (logistics-ai, finance-agent...).
model Solution {
  id           String                @id @default(cuid())
  slug         String                @unique
  sector       String
  impact       String
  order        Int                   @default(0)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tags         SolutionTag[]
  translations SolutionTranslation[]
}

model SolutionTranslation {
  id         String   @id @default(cuid())
  solutionId String
  locale     Locale
  title      String
  summary    String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([solutionId, locale])
  @@index([locale])
}

model SolutionTag {
  id         String   @id @default(cuid())
  solutionId String
  tag        String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([solutionId, tag])
}

model BlogCategory {
  id           String                    @id @default(cuid())
  key          String                    @unique
  colorClass   String?
  order        Int                       @default(0)
  active       Boolean                   @default(true)
  translations BlogCategoryTranslation[]
  posts        BlogPost[]
}

model BlogCategoryTranslation {
  id             String       @id @default(cuid())
  blogCategoryId String
  locale         Locale
  label          String
  category       BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)

  @@unique([blogCategoryId, locale])
}

model BlogPost {
  id           String                @id @default(cuid())
  slug         String                @unique
  date         DateTime
  readingTime  String
  author       String
  categoryId   String
  published    Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  category     BlogCategory          @relation(fields: [categoryId], references: [id])
  tags         BlogPostTag[]
  translations BlogPostTranslation[]

  @@index([date])
  @@index([categoryId])
  @@index([published])
}

model BlogPostTranslation {
  id         String   @id @default(cuid())
  blogPostId String
  locale     Locale
  title      String
  excerpt    String
  post       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, locale])
}

model BlogPostTag {
  id         String   @id @default(cuid())
  blogPostId String
  tag        String
  post       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, tag])
}

model Capability {
  id           String                  @id @default(cuid())
  key          String                  @unique
  order        Int                     @default(0)
  features     CapabilityFeature[]
  translations CapabilityTranslation[]
}

model CapabilityTranslation {
  id           String     @id @default(cuid())
  capabilityId String
  locale       Locale
  stretch      String
  title        String
  description  String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, locale])
}

model CapabilityFeature {
  id           String     @id @default(cuid())
  capabilityId String
  order        Int        @default(0)
  textFr       String
  textEn       String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId])
}

model Testimonial {
  id           String                   @id @default(cuid())
  clientLogoId String?
  author       String
  order        Int                      @default(0)
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  clientLogo   ClientLogo?              @relation(fields: [clientLogoId], references: [id])
  translations TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String      @id @default(cuid())
  testimonialId String
  locale        Locale
  quote         String
  role          String
  company       String
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, locale])
}

model NavItem {
  id           String               @id @default(cuid())
  viewKey      String               @unique
  order        Int                  @default(0)
  visible      Boolean              @default(true)
  translations NavItemTranslation[]
}

model NavItemTranslation {
  id        String  @id @default(cuid())
  navItemId String
  locale    Locale
  label     String
  hint      String
  navItem   NavItem @relation(fields: [navItemId], references: [id], onDelete: Cascade)

  @@unique([navItemId, locale])
}

model MarqueeKeyword {
  id      String  @id @default(cuid())
  locale  Locale
  keyword String
  order   Int     @default(0)
  active  Boolean @default(true)

  @@unique([locale, keyword])
  @@index([locale])
}

model ActivityLogEntry {
  id           String                        @id @default(cuid())
  time         String
  level        String
  order        Int                           @default(0)
  active       Boolean                       @default(true)
  createdAt    DateTime                      @default(now())
  translations ActivityLogEntryTranslation[]
}

model ActivityLogEntryTranslation {
  id                 String           @id @default(cuid())
  activityLogEntryId String
  locale             Locale
  event              String
  entry              ActivityLogEntry @relation(fields: [activityLogEntryId], references: [id], onDelete: Cascade)

  @@unique([activityLogEntryId, locale])
}

model CompanyValue {
  id           String                    @id @default(cuid())
  iconKey      String
  order        Int                       @default(0)
  translations CompanyValueTranslation[]
}

model CompanyValueTranslation {
  id             String       @id @default(cuid())
  companyValueId String
  locale         Locale
  title          String
  description    String
  value          CompanyValue @relation(fields: [companyValueId], references: [id], onDelete: Cascade)

  @@unique([companyValueId, locale])
}

model DeliveryStep {
  id           String                    @id @default(cuid())
  iconKey      String
  order        Int                       @default(0)
  translations DeliveryStepTranslation[]
}

model DeliveryStepTranslation {
  id             String       @id @default(cuid())
  deliveryStepId String
  locale         Locale
  label          String
  description    String
  step           DeliveryStep @relation(fields: [deliveryStepId], references: [id], onDelete: Cascade)

  @@unique([deliveryStepId, locale])
}

model LegalSection {
  id           String                    @id @default(cuid())
  type         String
  order        Int
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  translations LegalSectionTranslation[]

  @@index([type])
}

model LegalSectionTranslation {
  id             String       @id @default(cuid())
  legalSectionId String
  locale         Locale
  heading        String
  body           String
  section        LegalSection @relation(fields: [legalSectionId], references: [id], onDelete: Cascade)

  @@unique([legalSectionId, locale])
}

model SiteConfig {
  id             String   @id @default("singleton")
  siteName       String
  url            String
  email          String
  phone          String
  phoneHref      String
  streetAddress  String
  city           String
  postalCode     String
  country        String
  countryCode    String
  socialLinkedin String?
  socialTwitter  String?
  socialGithub   String?
  geoLat         Float?
  geoLng         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Configuration technique de l'app (seuils, durations, rate limits...).
/// Utilise un modèle clé-valeur flexible plutôt que des colonnes fixes.
model AppConfig {
  id        String       @id @default(cuid())
  key       AppConfigKey @unique
  value     String
  updatedAt DateTime     @updatedAt
}

/// SEO metadata par locale
model SeoMetadata {
  id            String                   @id @default("singleton")
  titleTemplate String
  canonicalUrl  String
  ogImageUrl    String?
  twitterCard   String                   @default("summary_large_image")
  robotsIndex   Boolean                  @default(true)
  robotsFollow  Boolean                  @default(true)
  translations  SeoMetadataTranslation[]
}

model SeoMetadataTranslation {
  id            String      @id @default(cuid())
  seoMetadataId String
  locale        Locale
  title         String
  description   String
  keywords      String[]
  ogTitle       String?
  ogDescription String?
  seo           SeoMetadata @relation(fields: [seoMetadataId], references: [id], onDelete: Cascade)

  @@unique([seoMetadataId, locale])
}

/// JSON-LD structured data (Organization, WebSite, FAQ, ...)
model SeoSchema {
  id        String   @id @default(cuid())
  type      String   @unique
  active    Boolean  @default(true)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// FAQ structurée pour SEO (rich snippets)
model FaqEntry {
  id           String                @id @default(cuid())
  order        Int                   @default(0)
  active       Boolean               @default(true)
  category     FaqCategory           @default(general)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  translations FaqEntryTranslation[]
}

model FaqEntryTranslation {
  id         String   @id @default(cuid())
  faqEntryId String
  locale     Locale
  question   String
  answer     String
  entry      FaqEntry @relation(fields: [faqEntryId], references: [id], onDelete: Cascade)

  @@unique([faqEntryId, locale])
}

model BlockedEmailDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SuspiciousUAPattern {
  id        String               @id @default(cuid())
  pattern   String               @unique
  category  SuspiciousUACategory @default(scanner)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
}

model ContactRequest {
  id          String        @id @default(cuid())
  reference   String        @unique
  prenom      String
  nom         String
  email       String
  entreprise  String
  sujet       String
  message     String
  ipHash      String?
  fingerprint String?
  userAgent   String?
  origin      String?
  status      ContactStatus @default(new)
  consent     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum Locale {
  fr
  en
}

enum MetricSource {
  static
  stream
  activity
}

enum ContactStatus {
  new
  contacted
  closed
  spam
}

enum FaqCategory {
  general
  technical
  commercial
  legal
}

enum AppConfigKey {
  scroll_glass_effect_px
  scroll_auto_hide_px
  scroll_delta_px
  scroll_back_to_top_px
  anim_page_transition_ms
  anim_theme_transition_ms
  anim_marquee_slow_sec
  anim_marquee_medium_sec
  anim_marquee_fast_sec
  anim_loader_ms
  rate_limit_contact_per_hr
  rate_limit_contact_window_ms
  max_body_size_bytes
  csrf_cookie_name
  csrf_header_name
  consent_storage_key
  consent_version
  mail_from
  mail_to
  app_version
}

enum SuspiciousUACategory {
  scanner
  crawler
  exploit
  bot
  spam
}
