// Analyticatech — Schéma Prisma
// Données dynamiques : métriques, logos clients, demandes de contact

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === Métriques dynamiques affichées sur la home ===
// (missions livrées, coûts réduits, uptime, satisfaction, etc.)
model Metric {
  id        String   @id @default(cuid())
  key       String   @unique // "missions_delivered", "cost_reduction", etc.
  label     String             // "Missions livrées"
  value     String             // "120+" ou "38%" ou "99.98%"
  numericValue Float?          // 120.0 ou 38.0 — pour tris/graphs
  suffix    String?            // "%" ou "+"
  order     Int      @default(0) // ordre d'affichage
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === Logos / entreprises clientes (section "Ils nous confient") ===
model ClientLogo {
  id        String   @id @default(cuid())
  name      String   @unique // "NOVA BANK"
  sector    String?            // "Finance", "Logistique"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === Demandes de contact (persistance API) ===
model ContactRequest {
  id         String   @id @default(cuid())
  reference  String   @unique // "AT-2026-XXXXXX"
  prenom     String
  nom        String
  email      String
  entreprise String
  sujet      String
  message    String
  ipHash     String? // RGPD : IP hashée, pas d'IP en clair
  fingerprint String? // fingerprint navigateur hashé
  status     String   @default("new") // new, contacted, closed
  consent    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
