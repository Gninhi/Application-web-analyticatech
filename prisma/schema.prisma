generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

/// La base ne sert qu'aux demandes de contact et aux listes de sécurité.
/// Le contenu éditorial est versionné dans le code (src/lib/content, src/locales).

model ContactRequest {
  id          String        @id @default(cuid())
  reference   String        @unique
  prenom      String
  nom         String
  email       String
  entreprise  String
  sujet       String
  message     String
  ipHash      String?
  fingerprint String?
  userAgent   String?
  origin      String?
  status      ContactStatus @default(new)
  consent     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model BlockedEmailDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SuspiciousUAPattern {
  id        String               @id @default(cuid())
  pattern   String               @unique
  category  SuspiciousUACategory @default(scanner)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
}

enum ContactStatus {
  new
  contacted
  closed
  spam
}

enum SuspiciousUACategory {
  scanner
  crawler
  exploit
  bot
  spam
}
